{
  "name": "openKylin 3.0 Desktop VNC",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "privileged": true,
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "noVNC Desktop",
      "onAutoForward": "openBrowser"
    }
  },
  "runArgs": ["--cap-add=SYS_ADMIN"],
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-vnc.sh",
  "customizations": {
    "vscode": {
      "extensions": []
    }
  }
}
